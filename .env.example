# Market Radar runs on loopback by design. Keep remote access behind an authenticated proxy.
MARKET_RADAR_HOST=127.0.0.1
MARKET_RADAR_PORT=8787
MARKET_RADAR_LIVE=true
# MARKET_RADAR_ALLOWED_ORIGINS=https://radar.example.internal
# MARKET_RADAR_DB_PATH=./data/market-radar.sqlite
# MARKET_RADAR_USER_AGENT=MarketRadar/1.0 personal-research contact=local

# Optional authenticated providers. Never commit real values.
# POLYGON_API_KEY=
# TWELVEDATA_API_KEY=
# ALPHAVANTAGE_API_KEY=
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
